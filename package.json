{
  "name": "osmedeus-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bunx --bun next dev",
    "dev:clean": "rm -rf .next && bunx --bun next dev",
    "build": "bunx --bun next build",
    "build:dist": "rm -rf dist && NEXT_STATIC_EXPORT=true bunx --bun next build && cp -R static/. dist/static/",
    "start": "bunx --bun next start",
    "lint": "bunx --bun eslint . --max-warnings=0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
